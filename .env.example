DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AGENT_MAX_STEPS=6

APP_ENV=development

HF_ENDPOINT=https://hf-mirror.com
HF_HOME=models/huggingface
SENTENCE_TRANSFORMERS_HOME=models/sentence-transformers
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

RERANKER_MODEL_PATH=models/bge-reranker-base

MODEL_DIR=./models

POSTGRES_PASSWORD=replace_with_url_safe_random_password
DATABASE_URL=postgresql+psycopg://rag:replace_with_url_safe_random_password@localhost:5432/enterprise_rag
JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_ENABLED=0
RATE_LIMIT_FAIL_OPEN=1
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_AGENT_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_DELETE_PER_HOUR=30
RATE_LIMIT_KB_CREATE_PER_HOUR=10

LLM_CACHE_HIT_PRICE_PER_MILLION=0.04
LLM_CACHE_MISS_PRICE_PER_MILLION=2
LLM_OUTPUT_PRICE_PER_MILLION=8
